name = "kakao-account-api-preview"
main = "src/app.ts"
compatibility_date = "2026-09-05"

# Preview must use a dedicated D1 database.
# The actual database ID is injected by the GitHub Actions preview workflow.
[triggers]
crons = ["0 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "kakao-account-db-preview"
database_id = "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"
migrations_dir = "migrations"

[vars]
# Replace these values in the generated preview config before deployment.
APP_BASE_URL = "REPLACE_WITH_PREVIEW_APP_BASE_URL"
KAKAO_REDIRECT_URI = "REPLACE_WITH_PREVIEW_KAKAO_REDIRECT_URI"
